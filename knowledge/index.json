 "notices": {
  "medical": {
   "tr": "Bu bilgiler genel bilgilendirme amaçlıdır, tıbbi tavsiye değildir. Acil durumda 112'yi arayın.",
   "en": "This is general information, not medical advice. In an emergency call your local emergency number (112 in Turkey and the EU).",
   "de": "Dies ist allgemeine Information und keine medizinische Beratung. Im Notfall rufen Sie den Notruf an (112 in der Türkei und der EU).",
   "ru": "Это общая информация, а не медицинская рекомендация. В экстренной ситуации звоните в службу спасения (112 в Турции и ЕС).",
   "ar": "هذه معلومات عامة وليست نصيحة طبية. في حالة الطوارئ اتصل برقم الطوارئ (112 في تركيا والاتحاد الأوروبي)."
  },
  "foraging": {
   "tr": "Yabani bitki ve mantarı yalnızca bu bilgiye veya bir fotoğrafa bakarak asla yemeyin. Yanlış tanıma zehirlenmeye ve ölüme yol açabilir. Emin değilseniz bir uzmana danışın.",
   "en": "Never eat a wild plant or mushroom based only on this information or a photo. Misidentification can cause poisoning or death. If unsure, consult an expert.",
   "de": "Essen Sie niemals eine Wildpflanze oder einen Pilz allein aufgrund dieser Informationen oder eines Fotos. Fehlbestimmungen können zu Vergiftung oder Tod führen. Fragen Sie im Zweifel einen Experten.",
   "ru": "Никогда не ешьте дикорастущие растения и грибы, полагаясь только на эту информацию или фотографию. Ошибка в определении может привести к отравлению и смерти. Если сомневаетесь, обратитесь к специалисту.",
   "ar": "لا تأكل نباتًا برّيًا أو فطرًا اعتمادًا على هذه المعلومات أو على صورة فقط. الخطأ في التعرّف قد يسبب التسمم أو الوفاة. إذا لم تكن متأكدًا فاستشر خبيرًا."
  },
  "poisonous": {
   "tr": "Bu tür zehirli veya tehlikeli olabilir. Dokunmayın, yemeyin; temas veya yeme durumunda hemen 112'yi arayın.",
   "en": "This species can be poisonous or dangerous. Do not touch or eat it; after contact or ingestion call emergency services (112) immediately.",
   "de": "Diese Art kann giftig oder gefährlich sein. Nicht berühren oder essen; nach Kontakt oder Verzehr sofort den Notruf (112) wählen.",
   "ru": "Этот вид может быть ядовитым или опасным. Не трогайте и не ешьте; при контакте или попадании внутрь сразу звоните 112.",
   "ar": "قد يكون هذا النوع ساماً أو خطيراً. لا تلمسه ولا تأكله؛ عند التلامس أو الابتلاع اتصل بالطوارئ (112) فوراً."
  },
  "wildlife": {
   "tr": "Vahşi hayvanlara yaklaşmayın, uzaktan izleyin. Isırık veya sokma durumunda sakin kalın ve hemen sağlık yardımı alın.",
   "en": "Keep your distance from wild animals. After a bite or sting stay calm and seek medical help immediately.",
   "de": "Halten Sie Abstand zu Wildtieren. Bleiben Sie nach einem Biss oder Stich ruhig und suchen Sie sofort ärztliche Hilfe.",
   "ru": "Держитесь на расстоянии от диких животных. После укуса или ужаления сохраняйте спокойствие и немедленно обратитесь за медицинской помощью.",
   "ar": "ابقَ بعيدًا عن الحيوانات البرية. بعد العضّة أو اللدغة حافظ على هدوئك واطلب المساعدة الطبية فورًا."
  }
 },
